<selector xmlns:android="http://schemas.android.com/apk/res/android" >

  <item android:state_pressed="false" >
    <layer-list>
      <item android:right="0.5dp" android:top="0.5dp">
        <shape>
          <corners android:radius="3dp" />
          <!--<solid android:color="@android:color/darker_gray"/>-->
        </shape>
      </item>

      <item android:bottom="2dp" android:left="2dp">
        <shape>
          <gradient android:angle="270" android:endColor="#df4e12" android:startColor="#df4e12" />
          <!--<stroke android:width="1dp" android:color="#BABABA"  />-->
          <corners android:radius="4dp" />
          <padding android:bottom="10dp" android:left="10dp" android:right="10dp" android:top="10dp" />
        </shape>
      </item>
    </layer-list>
  </item>

  <item android:state_pressed="true" >
    <layer-list>
      <item android:right="0.5dp" android:top="0.5dp">
        <shape>
          <corners android:radius="3dp" />
          <solid android:color="#ff7043"/>
        </shape>
      </item>

      <item android:bottom="2dp" android:left="2dp">
        <shape>
          <gradient android:angle="270" android:endColor="#ff7043" android:startColor="#ff7043" />
          <stroke android:width="1dp" android:color="#ff7043"  />
          <corners android:radius="4dp" />
          <padding android:bottom="10dp" android:left="10dp" android:right="10dp" android:top="10dp" />
        </shape>
      </item>
    </layer-list>
  </item>

</selector>

