<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="25px"
    android:minHeight="25px"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <android.support.v7.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:layout_marginTop="5dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp">
        <LinearLayout
                style="@style/Widget.CardContent"
               android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
               android:gravity="center">
            <me.grantland.widget.AutofitTextView
                android:id="@+id/NombreCliente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"               
                android:layout_marginBottom="@dimen/card_subtitle_margin"
                android:layout_marginStart="@dimen/card_subtitle_margin"
                android:layout_marginEnd="@dimen/card_subtitle_margin"
                android:layout_marginTop="@dimen/card_button_margin"
                android:text="Nombre del cliente" />
            <View
                android:layout_height="0.3dp"
                android:id="@+id/view_card_about_Vendedor"
                android:layout_width="match_parent"
                android:layout_below="@id/NombreCliente"
                android:background="@color/main_background" />
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="5dp"
                android:id="@+id/LinearBaja">             
                <TextView
                    android:text="Selecciona la razon de baja:"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/TxtBaja"
                    android:gravity="center"
                    android:textStyle="bold" />       
                <Spinner
                    style="@style/Widget.AppCompat.Spinner.Underlined"
                    android:gravity="center_horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/SPMotivosBaja"
                    android:spinnerMode="dropdown"
                    android:textSize="8sp"
                    android:layout_marginRight="20dp"
                    android:layout_marginLeft="20dp" />
                <Button
                    android:text="Enviar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="20dp"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/Buttoncomprar"
                    android:textColor="#ffffff"
                    android:id="@+id/EnviarBaja" />
            </LinearLayout>
        </LinearLayout>
    </android.support.v7.widget.CardView>
</RelativeLayout>