<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:id="@+id/ll_card_about_Pronostico"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Widget.CardContent"
        android:background="?android:selectableItemBackground"
        android:clickable="true"
        android:orientation="horizontal">
        <Button
            android:text="Agregar recurso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="20dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/Buttoncomprar"
            android:textColor="#ffffff"
            android:id="@+id/AgregarRecurso" />
    </LinearLayout>
      <View
        android:layout_height="0.3dp"
        android:id="@+id/view_card_about_Pronostico"
        android:layout_width="match_parent"
        android:layout_below="@id/ll_card_about_Pronostico"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="30dp"
        android:background="@color/main_background" />
    <ListView
        android:minWidth="25px"
        android:minHeight="64px"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:id="@android:id/list" />
    
        
</LinearLayout>
