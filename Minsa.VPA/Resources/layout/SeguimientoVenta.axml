<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:appname="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="25px"
    android:minHeight="25px"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <android.support.v7.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:layout_marginTop="5dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp">
        <LinearLayout
            style="@style/Widget.CardContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <me.grantland.widget.AutofitTextView
                android:id="@+id/NombreVendedorVenta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/titulo"
                android:layout_marginBottom="@dimen/card_subtitle_margin"
                android:layout_marginStart="@dimen/card_subtitle_margin"
                android:layout_marginEnd="@dimen/card_subtitle_margin"
                android:layout_marginTop="@dimen/card_button_margin"
                android:text="Nombre del vendedor" />
            <View
                android:layout_height="0.3dp"
                android:id="@+id/view_card_about_Vendedor"
                android:layout_width="match_parent"
                android:layout_below="@id/ClienteId"
                android:background="@color/main_background" />
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="5dp"
                android:id="@+id/SeguimientoDeVenta">
                <TextView
                    android:text="¿El cliente compra/compraba a la competencia?:"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/text_margin_very_small"                    
                    android:gravity="center_horizontal"
                    android:textStyle="bold"
                    android:id="@+id/SeguimientoDeVentaCompetenciaTexto"/>
                <CheckBox
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/SeguimientoDeVentaCompetenciaRespuesta"
                    android:layout_marginLeft="170dp" />
                <Spinner
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="20dp"
                    android:layout_marginLeft="20dp"
                    style="@style/Widget.AppCompat.Spinner.Underlined"
                    android:spinnerMode="dropdown"
                    android:gravity="center_horizontal"
                    android:id="@+id/SeguimientoDeVentaCompetencia" />
                <TextView
                    android:text="Razon por la cual:"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/text_margin_very_small"                    
                    android:gravity="center_horizontal"
                    android:id="@+id/TxtResultadoRazon"                    
                    android:textStyle="bold" />
            
                <Spinner
                    style="@style/Widget.AppCompat.Spinner.Underlined"
                    android:gravity="center_horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/SPRazon"
                    android:spinnerMode="dropdown"
                    android:textSize="8sp"
                    android:layout_marginRight="20dp"
                    android:layout_marginLeft="20dp" />

                <TextView
                    android:text="Motivo:"
                   android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/text_margin_very_small"                    
                    android:gravity="center_horizontal"
                    android:id="@+id/TxtMotivoRazon"                    
                    android:textStyle="bold" />
                 <Spinner
                    style="@style/Widget.AppCompat.Spinner.Underlined"
                    android:gravity="center_horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/SPPrecio"
                    android:spinnerMode="dropdown"
                    android:textSize="8sp"
                    android:layout_marginRight="20dp"
                    android:layout_marginLeft="20dp" />
                 <TextView                   
                    android:text="¿Cuál es el precio de venta por saco?"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/text_margin_very_small"                    
                    android:gravity="center_horizontal"
                    android:id="@+id/txtPrecioVentaSaco"                   
                    android:textStyle="bold" />                               
                  <android.support.design.widget.TextInputLayout
                    android:id="@+id/PrecioSacoinput"
                    android:backgroundTint="#9e9e9e"
                    android:textColorHint="#df4e12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <EditText
                        android:id="@+id/PrecioVentaSaco"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"                       
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:imeOptions="actionNext"
                        android:maxLength="20"
                        android:inputType="number"
                        android:textColorHint="#9e9e9e"
                        android:backgroundTint="#df4e12"
                        android:maxLines="1"
                        android:textColor="#000000"
                        android:layout_marginRight="40dp"
                        android:layout_marginLeft="40dp"
                        android:singleLine="true" />
                </android.support.design.widget.TextInputLayout>
                  <TextView                  
                    android:text="¿Maneja promocion o apoyo con la competencia?"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/text_margin_very_small"                    
                    android:gravity="center_horizontal"
                    android:id="@+id/txtPromocionApoyoCompetencia"
                    android:textStyle="bold" />

                  <CheckBox
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/CheckPromocionApoyoCompetencia"
                    android:layout_marginLeft="170dp" />                
                
                <Spinner
                    style="@style/Widget.AppCompat.Spinner.Underlined"
                    android:gravity="center_horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/SPApoyoDado"
                    android:spinnerMode="dropdown"
                    android:textSize="8sp"
                    android:layout_marginRight="20dp"
                    android:layout_marginLeft="20dp" />
                  <TextView                 
                    android:text="¿Cantidad x TM?"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/text_margin_very_small"                    
                    android:gravity="center_horizontal"
                    android:id="@+id/txtCantidadTM"                    
                    android:textStyle="bold" />
                  <android.support.design.widget.TextInputLayout
                    android:id="@+id/CantidadXTMinput"
                    android:backgroundTint="#9e9e9e"
                    android:textColorHint="#df4e12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <EditText
                        android:id="@+id/CantidadXTM"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"                        
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:imeOptions="actionNext"
                        android:maxLength="50"
                        android:textColorHint="#9e9e9e"
                        android:backgroundTint="#df4e12"
                        android:maxLines="1"
                        android:inputType="number"
                        android:textColor="#000000"
                        android:layout_marginRight="40dp"
                        android:layout_marginLeft="40dp"
                        android:singleLine="true" />               
                </android.support.design.widget.TextInputLayout>

                <TextView                 
                    android:text="¿Qué insumo es?"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/text_margin_very_small"                    
                    android:gravity="center_horizontal"
                    android:id="@+id/txtQueInsumoes"                    
                    android:textStyle="bold" />
                  <android.support.design.widget.TextInputLayout
                    android:id="@+id/txtQueInsumoesinput"
                    android:backgroundTint="#9e9e9e"
                    android:textColorHint="#df4e12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <EditText
                        android:id="@+id/QueInsumoes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"                        
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:imeOptions="actionNext"
                        android:maxLength="50"
                        android:textColorHint="#9e9e9e"
                        android:backgroundTint="#df4e12"
                        android:maxLines="1"
                        android:textColor="#000000"
                        android:layout_marginRight="40dp"
                        android:layout_marginLeft="40dp"
                        android:singleLine="true" />               
                </android.support.design.widget.TextInputLayout>
                      
                  <TextView                 
                    android:text="¿Qué tipo de apoyo te dieron?"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/text_margin_very_small"                    
                    android:gravity="center_horizontal"
                    android:id="@+id/txtApoyoDieron"                    
                    android:textStyle="bold" />     
                  <Spinner
                    style="@style/Widget.AppCompat.Spinner.Underlined"
                    android:gravity="center_horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/SPApoyos"
                    android:spinnerMode="dropdown"
                    android:textSize="8sp"
                    android:layout_marginRight="20dp"
                    android:layout_marginLeft="20dp" />

                <TextView                 
                    android:text="¿Que plazo de vigencia tiene su promoción y/o apoyo?"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/text_margin_very_small"                    
                    android:gravity="center_horizontal"
                    android:id="@+id/txtPlazoVigencia"
                    android:textStyle="bold" />
                <android.support.design.widget.TextInputLayout
                    android:id="@+id/VigenciaPromocioninput"
                    android:backgroundTint="#9e9e9e"
                    android:textColorHint="#df4e12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <EditText
                        android:id="@+id/VigenciaPromocion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"                        
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:imeOptions="actionNext"
                        android:maxLength="50"
                        android:textColorHint="#9e9e9e"
                        android:backgroundTint="#df4e12"
                        android:maxLines="1"
                        android:textColor="#000000"
                        android:layout_marginRight="40dp"
                        android:layout_marginLeft="40dp"
                        android:singleLine="true" />
                </android.support.design.widget.TextInputLayout>
             <!--   <EditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/style_margin"
                    android:layout_marginRight="@dimen/style_margin"
                    android:hint="Vigencia"
                    android:inputType="number"
                    android:maxLength="30"
                    android:id="@+id/VigenciaPromocion" />            -->

                <TextView                 
                    android:text="¿Cual es su frecuencia de compra?"
                   android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/text_margin_very_small"                    
                    android:gravity="center_horizontal"
                    android:id="@+id/txtFrecuenciaCompra"
                    android:textStyle="bold" />

                <Spinner
                    style="@style/Widget.AppCompat.Spinner.Underlined"
                    android:gravity="center_horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/SPFrecuencia"
                    android:spinnerMode="dropdown"
                    android:textSize="8sp"
                    android:layout_marginRight="20dp"
                    android:layout_marginLeft="20dp" />

                    <!-- Desharinizacion -->
                   <TextView                 
                    android:text="Harinizacion"
                   android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/text_margin_very_small"                    
                    android:gravity="center_horizontal"
                    android:id="@+id/txtDesharinizacion"
                    android:textStyle="bold" />

                <Spinner
                    style="@style/Widget.AppCompat.Spinner.Underlined"
                    android:gravity="center_horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/SPDesHarinizacion"
                    android:spinnerMode="dropdown"
                    android:textSize="8sp"
                    android:layout_marginRight="20dp"
                    android:layout_marginLeft="20dp" />

                 <TextView                 
                    android:text="¿A que precio lo compra?"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/text_margin_very_small"                    
                    android:gravity="center_horizontal"
                    android:id="@+id/txtPrecioCompra"
                    android:textStyle="bold" />
                 <android.support.design.widget.TextInputLayout
                    android:id="@+id/PrecioComprainput"
                    android:backgroundTint="#9e9e9e"
                    android:textColorHint="#df4e12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <EditText
                        android:id="@+id/PrecioCompra"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"                       
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:imeOptions="actionNext"
                        android:inputType="number"
                        android:maxLength="20"
                        android:textColorHint="#9e9e9e"
                        android:backgroundTint="#df4e12"
                        android:maxLines="1"
                        android:textColor="#000000"
                        android:layout_marginRight="40dp"
                        android:layout_marginLeft="40dp"
                        android:singleLine="true" />
                </android.support.design.widget.TextInputLayout>
              <!--  <EditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/style_margin"
                    android:layout_marginRight="@dimen/style_margin"
                    android:hint="Precio de compra"
                    android:inputType="number"
                    android:maxLength="30"
                    android:id="@+id/PrecioCompra" />-->
                <TextView                 
                    android:text="¿Cuántas sacos o kilos de masa consume diario?"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/text_margin_very_small"                    
                    android:gravity="center_horizontal"
                    android:id="@+id/txtSacosConsumeDiario"
                    android:textStyle="bold" />
                <android.support.design.widget.TextInputLayout
                    android:id="@+id/SacosConsumeDiarioinput"
                    android:backgroundTint="#9e9e9e"
                    android:textColorHint="#df4e12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <EditText
                        android:id="@+id/SacosConsumeDiario"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"                       
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:imeOptions="actionNext"
                        android:maxLength="20"
                        android:textColorHint="#9e9e9e"
                        android:backgroundTint="#df4e12"
                        android:maxLines="1"
                        android:textColor="#000000"
                        android:layout_marginRight="40dp"
                        android:layout_marginLeft="40dp"
                        android:singleLine="true" />
                </android.support.design.widget.TextInputLayout>
               <!-- <EditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/style_margin"
                    android:layout_marginRight="@dimen/style_margin"
                    android:hint="Vigencia"
                    android:inputType="number"
                    android:maxLength="30"
                    android:id="@+id/SacosConsumeDiario" />-->

                <!-- Desharinizacion -->

                <!-- Atencion a otra figura -->

                   <TextView                 
                    android:text="¿Quien le esta vendiendo"
                   android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/text_margin_very_small"                    
                    android:gravity="center_horizontal"
                    android:id="@+id/txtQuienVendiendo"
                    android:textStyle="bold" />

                <Spinner
                    style="@style/Widget.AppCompat.Spinner.Underlined"
                    android:gravity="center_horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/SPQuienVende"
                    android:spinnerMode="dropdown"
                    android:textSize="8sp"
                    android:layout_marginRight="20dp"
                    android:layout_marginLeft="20dp" />

                 <TextView                 
                    android:text="¿Cuál es el nombre del comercializador, revendedor o la ruta IMT que le vende?"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/text_margin_very_small"                    
                    android:gravity="center_horizontal"
                    android:id="@+id/txtNombreComercializador"
                    android:textStyle="bold" />
                <android.support.design.widget.TextInputLayout
                    android:id="@+id/NombreComercializadorinput"
                    android:backgroundTint="#9e9e9e"
                    android:textColorHint="#df4e12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <EditText
                        android:id="@+id/NombreComercializador"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"                        
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:imeOptions="actionNext"
                        android:maxLength="20"
                        android:textColorHint="#9e9e9e"
                        android:backgroundTint="#df4e12"
                        android:maxLines="1"
                        android:textColor="#000000"
                        android:layout_marginRight="40dp"
                        android:layout_marginLeft="40dp"
                        android:singleLine="true" />
                </android.support.design.widget.TextInputLayout>

                <!--Atencion a otra figura  -->

                    
                 <TextView                 
                    android:text="¿Cuál es el nuevo numero de cliente con el que compra?"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/text_margin_very_small"                    
                    android:gravity="center_horizontal"
                    android:id="@+id/txtNoCteCompra"
                    android:textStyle="bold" />
                <android.support.design.widget.TextInputLayout
                    android:id="@+id/NoCteComprainput"
                    android:backgroundTint="#9e9e9e"
                    android:textColorHint="#df4e12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <EditText
                        android:id="@+id/NoCteCompra"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"                        
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:imeOptions="actionNext"
                        android:maxLength="20"
                        android:textColorHint="#9e9e9e"
                        android:backgroundTint="#df4e12"
                        android:maxLines="1"
                        android:textColor="#000000"
                        android:layout_marginRight="40dp"
                        android:layout_marginLeft="40dp"
                        android:singleLine="true" />
                </android.support.design.widget.TextInputLayout>
                <TextView                 
                    android:text="¿Cuál es el nombre del nuevo cliente con el que compra?"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/text_margin_very_small"                    
                    android:gravity="center_horizontal"
                    android:id="@+id/txtNombreCteCompra"
                    android:textStyle="bold" />
                <android.support.design.widget.TextInputLayout
                    android:id="@+id/NombreCteComprainput"
                    android:backgroundTint="#9e9e9e"
                    android:textColorHint="#df4e12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <EditText
                        android:id="@+id/NombreCteCompra"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"                        
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:imeOptions="actionNext"
                        android:maxLength="60"
                        android:textColorHint="#9e9e9e"
                        android:backgroundTint="#df4e12"
                        android:maxLines="1"
                        android:textColor="#000000"
                        android:layout_marginRight="40dp"
                        android:layout_marginLeft="40dp"
                        android:singleLine="true" />
                </android.support.design.widget.TextInputLayout>

                 <TextView                 
                    android:text="¿Cuál es la fecha de la proxima compra?"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/text_margin_very_small"                    
                    android:gravity="center_horizontal"
                    android:id="@+id/txtFechaProximaCompra"
                    android:textStyle="bold" />
                  <TextView                 
                   
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/text_margin_very_small"                    
                    android:gravity="center_horizontal"
                    android:id="@+id/FechaProximaCompraDisplay"
                    android:textStyle="bold" />
                   <Button
                    android:text="Selecciona una fecha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="20dp"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="2dp"
                    android:background="@color/blue_primary_dark"
                    android:textColor="#ffffff"
                    android:id="@+id/FechaProximaCompra" />
     

                   <TextView                 
                    android:text="¿Qué tipo de cierre es?"
                     android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/text_margin_very_small"                    
                    android:gravity="center_horizontal"
                    android:id="@+id/txtTipoCierre"
                    android:textStyle="bold" />

                <Spinner
                    style="@style/Widget.AppCompat.Spinner.Underlined"
                    android:gravity="center_horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/SPTipoCierre"
                    android:spinnerMode="dropdown"
                    android:textSize="8sp"
                    android:layout_marginRight="20dp"
                    android:layout_marginLeft="20dp" />
                   <View
                android:layout_height="0.3dp"
                android:id="@+id/view_card_about_Seguimiento"
                android:layout_width="match_parent"
                 android:layout_marginTop="8dp"
                android:layout_below="@id/EnviarSeguimientoVenta"
                android:background="@color/main_background" />
                <Button
                    android:text="Enviar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="20dp"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/Buttoncomprar"
                    android:textColor="#ffffff"
                    android:id="@+id/EnviarSeguimientoVenta" />
                <View
                    android:layout_height="0.3dp"
                    android:id="@+id/view_card_about_Seguimiento"
                    android:layout_width="match_parent"
                    android:layout_marginTop="8dp"
                    android:layout_below="@id/EnviarSeguimientoVenta"
                    android:background="@color/main_background" />
                 <Button
                    android:text="Finalizar proceso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="20dp"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/buttonaccess"
                    android:textColor="#ffffff"
                    android:id="@+id/RegresaMenu" />
            </LinearLayout>
        </LinearLayout>
    </android.support.v7.widget.CardView>
</ScrollView>
</android.support.v4.widget.DrawerLayout>
