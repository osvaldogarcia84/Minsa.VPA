<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:appname="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/imagenMinsa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="80dp"
            android:layout_marginLeft="80dp"
            android:layout_marginTop="60dp"
            android:layout_marginBottom="40dp"
            android:src="@drawable/logominsa" />
        <android.support.design.widget.TextInputLayout
            android:id="@+id/input_user_name"
            android:backgroundTint="#9e9e9e"
            android:textColorHint="#df4e12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <EditText
                android:id="@+id/AccesoUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/login_user_name_hint"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:imeOptions="actionNext"
                android:maxLength="20"
                android:textColorHint="#9e9e9e"
                android:backgroundTint="#df4e12"
                android:maxLines="1"
                android:textColor="#000000"
                android:layout_marginRight="40dp"
                android:layout_marginLeft="40dp"
                android:singleLine="true" />
        </android.support.design.widget.TextInputLayout>
        <android.support.design.widget.TextInputLayout
            android:id="@+id/input_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#df4e12"
            appname:passwordToggleEnabled="true">
            <EditText
                android:id="@+id/AccesoPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:hint="@string/login_user_name_password"
                android:imeActionId="@+id/login"
                android:imeActionLabel="@string/action_sign_in"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:layout_marginRight="40dp"
                android:layout_marginLeft="40dp"
                android:textColorHint="#9e9e9e"
                android:backgroundTint="#df4e12"
                android:textColor="#000000"
                android:maxLength="20"
                android:maxLines="1"
                android:singleLine="true" />
        </android.support.design.widget.TextInputLayout>
        <Button
            android:id="@+id/AccesoEnviar"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="90dp"
            android:layout_marginLeft="90dp"
            android:textSize="15sp"
            android:background="@drawable/ButtonAccess"
            android:layout_marginTop="20dp"
            android:textColor="#ffffff"
            android:text="Ingresar" />
        <TextView
            android:text="2025 © Todos los derechos reservados. Minsa S.A. de C.V."
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/textView1"
            android:gravity="center_horizontal"
            android:layout_marginRight="20dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="20.0dp" />
        <TextView
            android:text="V 2.4.6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:layout_marginRight="20dp"
            android:layout_marginLeft="20dp" />
    </LinearLayout>
</android.support.v4.widget.DrawerLayout>