<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:minWidth="25px"
    android:minHeight="25px"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="12dp"
    android:id="@+id/LYHistoricoVenta"
    android:gravity="center_horizontal">
    <android.support.v7.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:layout_marginTop="5dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp">
        <RelativeLayout
            style="@style/Widget.CardContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:id="@+id/ll_card_Historico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:selectableItemBackground"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/txtSitios"
                    style="@style/TextAppearance.AppCompat.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/card_title_margin"
                    android:layout_marginTop="@dimen/card_title_margin_top"
                    android:text="Sitios :" />
                <ImageView
                    android:id="@+id/SitioSeleccionado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_title_margin_top"
                    android:layout_alignParentEnd="true"
                    android:src="@drawable/bookmark" />
            </LinearLayout>
            <View
                android:layout_height="0.3dp"
                android:id="@+id/view_card_about_Sitio"
                android:layout_width="match_parent"
                android:layout_below="@id/ll_card_Historico"
                android:background="@color/main_background" />
            <LinearLayout
                android:id="@+id/ll_card_about_Sitio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/view_card_about_Sitio"
                android:background="?android:selectableItemBackground"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_margin="@dimen/text_margin_very_small"
                    android:id="@+id/VendedorNombre"
                    android:text="Nombre del vendedor"
                    android:maxLines="1"
                    android:layout_below="@id/view_card_about_Sitio"
                    android:layout_marginBottom="@dimen/card_subtitle_margin"
                    android:layout_marginStart="@dimen/card_subtitle_margin"
                    android:layout_marginEnd="@dimen/card_subtitle_margin"
                    android:layout_marginTop="@dimen/card_button_margin" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/ll_card_VentaActual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/ll_card_about_Sitio"
                android:background="?android:selectableItemBackground"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_margin="@dimen/text_margin_very_small"
                    android:text="Venta actual: "
                    android:id="@+id/VentaActual" />
            </LinearLayout>
           <LinearLayout
                android:id="@+id/ll_card_Presupuesto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/ll_card_VentaActual"
                android:background="?android:selectableItemBackground"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_margin="@dimen/text_margin_very_small"
                    android:text="Presupuesto"
                    android:id="@+id/Presupuesto" />
            </LinearLayout>
             <LinearLayout
                android:id="@+id/ll_card_VentMesAnterior"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/ll_card_Presupuesto"
                android:background="?android:selectableItemBackground"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_margin="@dimen/text_margin_very_small"
                    android:text="Venta mes anterior"
                    android:id="@+id/VentaMesAnterior" />
            </LinearLayout>
             <LinearLayout
                android:id="@+id/ll_card_VentUltimosTreMeses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/ll_card_VentMesAnterior"
                android:background="?android:selectableItemBackground"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_margin="@dimen/text_margin_very_small"
                    android:text="Venta ultimos tres meses"
                    android:id="@+id/VentaUltimosTresMeses" />
            </LinearLayout>
            <Minsa.VPA.Views.GaugeView
                    android:id="@+id/gaugeVenta"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_below="@+id/ll_card_VentUltimosTreMeses"
                    android:layout_marginTop="12dp"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp" />
            <LinearLayout
                    android:id="@+id/llCumplimiento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/gaugeVenta"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp">

                    <TextView
                        android:id="@+id/txtDetalleCumplimiento"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="—"
                        android:textColor="#212121"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/txtEstadoCumplimiento"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="Pendiente"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold" />
        </LinearLayout>
