<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:minWidth="25px"
    android:minHeight="25px"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/card_rutas"
    android:gravity="center_horizontal">
    <android.support.v7.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:layout_marginTop="5dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp">
        <RelativeLayout
            style="@style/Widget.CardContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/ClienteIdOffline"
                style="@style/TextAppearance.AppCompat.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/card_title_margin"
                android:layout_marginEnd="@dimen/card_title_margin"
                android:layout_marginTop="@dimen/card_title_margin_top"
                android:text="Tipo : " />
            <View
                android:layout_height="0.3dp"
                android:id="@+id/view_card_about_Line"
                android:layout_width="match_parent"
                android:layout_below="@id/ClienteIdOffline"
                android:background="@color/main_background" />
            <LinearLayout
                android:id="@+id/ll_card_about_Cliente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/view_card_about_Line"
                android:background="?android:selectableItemBackground"
                android:orientation="horizontal">
                <me.grantland.widget.AutofitTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_margin="@dimen/text_margin_very_small"
                    android:id="@+id/ClienteNombreOffline"
                    android:text="Nombre del cliente"
                    android:textStyle="italic"
                    android:layout_below="@id/view_card_about_Line"
                    android:layout_marginBottom="@dimen/card_subtitle_margin"
                    android:layout_marginStart="@dimen/card_subtitle_margin"
                    android:layout_marginEnd="@dimen/card_subtitle_margin"
                    android:layout_marginTop="@dimen/card_button_margin" />
            </LinearLayout>
        </RelativeLayout>
    </android.support.v7.widget.CardView>
</LinearLayout>