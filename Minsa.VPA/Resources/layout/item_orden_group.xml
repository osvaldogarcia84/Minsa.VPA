<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:minWidth="25px"
    android:minHeight="25px"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="12dp"
    android:id="@+id/ordenesyalo"
    android:gravity="center_horizontal">
    <android.support.v7.widget.CardView 
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp">
     <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"       
        style="@style/Widget.CardContent"
        android:padding="12dp">
         <LinearLayout
                android:id="@+id/layoutInfo"
                android:orientation="vertical"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/imgExpand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
            <TextView
                android:id="@+id/ORDERID"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <TextView
                android:id="@+id/NOMBRECLIENTE"
                android:textSize="14sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <TextView
                android:id="@+id/ESTATUSBANCO"
                android:textSize="14sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <TextView
                android:id="@+id/ESTADOORDEN"
                android:textSize="14sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <TextView
                android:id="@+id/TIENEDISPONIBLE"
                android:textSize="14sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <TextView
                android:id="@+id/FORMADEPAGOYALO"
                android:textSize="14sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <TextView
                android:id="@+id/FECHACREACION"
                android:textSize="14sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#666666"/>       
             <TextView
                android:id="@+id/BLOQUEADA"
                android:textSize="14sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#666666"/>    
               <TextView
                android:id="@+id/TOTALAPAGAR"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#666666"/>    
        </LinearLayout>
      <View
                android:layout_height="0.3dp"
                android:id="@+id/View_factura"
                android:layout_width="match_parent"
                android:layout_below="@id/layoutInfo"
                android:background="@color/main_background" />
   <RelativeLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/layout_imgExpand"
    android:layout_below="@id/View_factura"
    android:padding="@dimen/card_button_margin">
    <Button
        android:id="@+id/btnFacturacion"
        android:text="Facturar orden"
        android:background="@drawable/Buttoncomprar"
        android:textColor="#ffffff"     
        
        android:layout_centerInParent="true"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
                    
        android:minHeight="36dp"
        android:minWidth="64dp" />
    <ImageView
        android:id="@+id/imgExpand"
        android:src="@android:drawable/arrow_down_float"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"     
        android:tint="#999999"/>
    </RelativeLayout>       
    </RelativeLayout>
</android.support.v7.widget.CardView>
</LinearLayout>
